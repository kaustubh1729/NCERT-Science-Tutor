# Copy to .env and fill in. Never commit .env.
#
#     cp .env.example .env

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# NVIDIA NIM — answer generation. Free tier: https://build.nvidia.com
NVIDIA_API_KEY=

# Cohere — reranking, and embeddings when NCERT_EMBEDDING_BACKEND=cohere.
# Free trial key: https://dashboard.cohere.com/api-keys
# Without it the system still runs, but ordering falls back to fusion score and
# retrieval precision drops noticeably.
COHERE_API_KEY=

# ------------------------------------------------------------------------------
# Architecture switches — the two that matter
# ------------------------------------------------------------------------------

# local  = sentence-transformers in-process. No network on the query path, no
#          per-query cost, but loads torch: ~943 MB RSS measured. Needs >= 2 GB.
# cohere = hosted embeddings. ~300 MB RSS, fits a 512 MB instance. One API call
#          per query (~30 ms, negligible beside a ~12 s generation call).
#
# The index must be BUILT with the same backend it is SERVED with — the two produce
# different vector spaces. Startup refuses to run on a mismatch.
NCERT_EMBEDDING_BACKEND=local

# fts5   = on-disk SQLite FTS5 index. ~1 ms to open, near-zero RSS.
# memory = rank_bm25 rebuilt at every cold start. ~60 MB, ~0.5 s.
# none   = dense retrieval only. Measurably worse on rare technical terms.
NCERT_LEXICAL_BACKEND=fts5

# ------------------------------------------------------------------------------
# Optional overrides — defaults in src/config.py are the tuned values
# ------------------------------------------------------------------------------

# NCERT_CHUNK_SIZE=800
# NCERT_CHUNK_OVERLAP=150
# NCERT_DENSE_K=10
# NCERT_LEXICAL_K=10
# NCERT_CANDIDATE_K=15
# NCERT_RERANK_TOP_N=5
# NCERT_RRF_K=60
# NCERT_RERANK_ENABLED=true
# NCERT_RERANK_MODEL=rerank-english-v3.0
# NCERT_LLM_MODEL=meta/llama-3.1-8b-instruct
# NCERT_LLM_TEMPERATURE=0.0
# NCERT_LOG_LEVEL=INFO

# Point the generator at any OpenAI-compatible endpoint — Groq, Together,
# OpenRouter, a local vLLM. Provider choice is a URL, not a rewrite.
# NCERT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
